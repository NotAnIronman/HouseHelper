    { "name": "Calendar", "short_name": "Calendar", "url": "./#calendar", "icons": [{ "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "icons": [
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
